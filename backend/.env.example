NODE_ENV=development
PORT=3000

# Conexión a la base: en local se arma con las 5 variables sueltas de abajo.
# En producción (Render), definir DATABASE_URL con la connection string que
# provee el servicio de Postgres — tiene prioridad sobre las variables
# sueltas y no hace falta completarlas.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=vetsystem

JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

ADMIN_EMAIL=admin@vetsystem.com
ADMIN_PASSWORD=change-me-too

# Usuario demo (rol EMPLOYEE, sin permisos de borrado ni gestión de
# usuarios) que se crea junto con el admin. Sin definir, usa los defaults
# de abajo — pensado para dar acceso de prueba en producción sin exponer
# el admin real.
# DEMO_EMAIL=demo@vetsystem.com
# DEMO_PASSWORD=demo1234

# Origen(es) permitidos por CORS, separados por coma. Sin definir, se permite
# cualquier origen (comportamiento actual en desarrollo local).
# FRONTEND_URL=https://mi-frontend.vercel.app
